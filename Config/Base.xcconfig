// TrueFocus build configuration.
//
// Signs with the same Apple Developer team as VocaMonkey. To build under a different
// team or prefix, copy Local.example.xcconfig to Local.xcconfig (git-ignored) and
// override them there.

TF_DEVELOPMENT_TEAM = 7CVSS54KS4
TF_BUNDLE_PREFIX = com.youngjingoh

// Sync server (Supabase). iPhone and Mac link with a one-time code in Settings › Sync.
// The anon key is public by design: row-level security and the device-held space key
// guard the data, which is encrypted on device. Leave both empty to keep data local.
TF_SUPABASE_HOST = fcfbsgvkanuywsmxvuee.supabase.co
TF_SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZjZmJzZ3ZrYW51eXdzbXh2dWVlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQxODcwMjYsImV4cCI6MjA5OTc2MzAyNn0.rS3izbF6-sK2vlpszMhRDw3ZiGKWrwSle98OTqMnbpw

#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(TF_DEVELOPMENT_TEAM)

// One App Group per device, shared by the app and its extensions.
// macOS wants team-prefixed group names; iOS uses the "group." form.
TF_APP_GROUP_IOS = group.$(TF_BUNDLE_PREFIX).truefocus
TF_APP_GROUP_MAC = $(TeamIdentifierPrefix)$(TF_BUNDLE_PREFIX).truefocus
TF_APP_GROUP[sdk=iphoneos*] = $(TF_APP_GROUP_IOS)
TF_APP_GROUP[sdk=iphonesimulator*] = $(TF_APP_GROUP_IOS)
TF_APP_GROUP[sdk=macosx*] = $(TF_APP_GROUP_MAC)
