<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  xcodebuild -exportArchive options for the Mac app: sign with Developer ID for direct
  download. Notarization happens afterwards in scripts/release/notarize-mac.sh.
  The Release workflow adds teamID at run time.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
</dict>
</plist>
