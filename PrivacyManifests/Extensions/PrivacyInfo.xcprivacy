<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest shared by every app extension:
  TrueFocusWidgets, TrueFocusMonitor, TrueFocusShieldConfig, TrueFocusShieldAction,
  TrueFocusSafariiOS and TrueFocusSafariMac.

  The extensions collect nothing and send nothing off the device. They read and write the
  App Group's UserDefaults suite (TrueFocusKit.SharedStore), which falls back to the
  extension's own standard defaults if the group is unavailable.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
